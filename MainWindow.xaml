<Window x:Class="DNP3_ProtocolAnalyzer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DNP3 Protocol Tester Analyzer"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        WindowStartupLocation="Manual"
        Left="80"
        Top="60"
        Width="1550"
        Height="930"
        MinWidth="1120"
        MinHeight="700"
        Background="#0F1115"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBgBrush" Color="#0F1115"/>
        <SolidColorBrush x:Key="PanelBgBrush" Color="#171B22"/>
        <SolidColorBrush x:Key="HeaderBgBrush" Color="#202632"/>
        <SolidColorBrush x:Key="BorderBrushSubtle" Color="#303848"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E8ECF2"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AFB8C5"/>
        <SolidColorBrush x:Key="AccentLineBrush" Color="#7CB8FF"/>

        <Style x:Key="FlatPanelBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBgBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="10"/>
        </Style>

        <Style x:Key="PanelTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="PanelSubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>

        <Style x:Key="AnalyzerButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="#2A3240"/>
            <Setter Property="BorderBrush" Value="#3A4457"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="AnalyzerDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#131820"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="AlternationCount" Value="2"/>
        </Style>

        <Style x:Key="LineMonitorListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="#10161E"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="BorderBrush" Value="#1D2633"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#18212C"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#22344A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#232C3A"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSubtle}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="DataGridRow">
            <Setter Property="Background" Value="#151B24"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="#17202C"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#2E4667"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="#202632"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushSubtle}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
    </Window.Resources>

    <Grid x:Name="MainLayoutGrid" Background="{StaticResource AppBgBrush}">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="MainLayoutScaleTransform" ScaleX="1" ScaleY="1"/>
        </Grid.LayoutTransform>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition x:Name="StatusSplitterRow" Height="6"/>
            <RowDefinition x:Name="StatusHistoryRow" Height="140"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource HeaderBgBrush}" BorderBrush="{StaticResource BorderBrushSubtle}" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="DNP3 Protocol Test &amp; Analyzer" Foreground="{StaticResource TextPrimaryBrush}" FontSize="21" FontWeight="SemiBold"/>
                    <TextBlock Text="Relay-focused capture workspace inspired by the IEC analyzer UX" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#3E4A61" BorderBrush="#60708E" BorderThickness="1" CornerRadius="10" Padding="10,4" Margin="0,0,8,0">
                        <TextBlock Text="{Binding AppStatus}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#1F4D73" BorderBrush="#4A7DA7" BorderThickness="1" CornerRadius="10" Padding="10,4" Margin="0,0,8,0">
                        <TextBlock Text="{Binding ProtocolBadge}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                    <Border Background="#2D3B4F" BorderBrush="#4D617F" BorderThickness="1" CornerRadius="10" Padding="10,4">
                        <TextBlock Text="{Binding CaptureStatus}" Foreground="White" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="#1A222E" BorderBrush="{StaticResource BorderBrushSubtle}" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Connection Setup" Style="{StaticResource AnalyzerButtonStyle}" Click="ConnectionSetupButton_Click"/>
                    <Button Content="Start Session" Style="{StaticResource AnalyzerButtonStyle}" Click="StartSessionButton_Click"/>
                    <Button Content="Load Sample" Style="{StaticResource AnalyzerButtonStyle}" Click="LoadSampleButton_Click"/>
                    <Button Content="Save Capture Data" Style="{StaticResource AnalyzerButtonStyle}" Click="SaveCaptureButton_Click"/>
                    <Button Content="Open Capture Data" Style="{StaticResource AnalyzerButtonStyle}" Click="OpenCaptureButton_Click"/>
                    <Button Content="Export Data" Style="{StaticResource AnalyzerButtonStyle}" Click="ExportDataButton_Click"/>
                </StackPanel>
                <TextBlock Text="{Binding TrafficSummaryText}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Margin="10,10,10,0" Style="{StaticResource FlatPanelBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Active Profile" Style="{StaticResource PanelTitleStyle}"/>
                    <TextBlock Text="{Binding ActiveProfile}" Style="{StaticResource PanelSubtitleStyle}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Scenario Pack" Style="{StaticResource PanelTitleStyle}"/>
                    <TextBlock Text="{Binding ScenarioSummary}" Style="{StaticResource PanelSubtitleStyle}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Workspace Status" Style="{StaticResource PanelTitleStyle}"/>
                    <TextBlock Text="{Binding WorkspaceStatus}" Style="{StaticResource PanelSubtitleStyle}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="10,10,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.10*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1.75*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource FlatPanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Line Monitor" Style="{StaticResource PanelTitleStyle}"/>
                        <TextBlock Text="Protocol trace text-list agar detail frame terbaca jelas seperti protocol tester industrial" Style="{StaticResource PanelSubtitleStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="Line Mode" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="LineMonitorModeCombo" Width="150" SelectedIndex="0" SelectionChanged="LineMonitorModeCombo_SelectionChanged">
                                <ComboBoxItem Content="Semantic"/>
                                <ComboBoxItem Content="RAW Classic"/>
                            </ComboBox>
                        </StackPanel>
                    </DockPanel>
                    <ListBox Grid.Row="2" ItemsSource="{Binding LineMonitorEntries}" Style="{StaticResource LineMonitorListBoxStyle}" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource AccentLineBrush}" BorderThickness="2,0,0,0" Padding="8,6,6,6">
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" FontFamily="Consolas" Foreground="{StaticResource TextPrimaryBrush}" LineHeight="18"/>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Background="#2D3545" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>

            <Border Grid.Column="2" Style="{StaticResource FlatPanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Analyzer Views" Style="{StaticResource PanelTitleStyle}"/>
                        <TextBlock Text="Measurement view, event log, findings, protocol context, dan legend dengan prioritas ruang utama untuk analisis operator" Style="{StaticResource PanelSubtitleStyle}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                            <TextBlock Text="Measurement View" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ComboBox x:Name="MeasurementModeCombo" Width="150" SelectedIndex="0" SelectionChanged="MeasurementModeCombo_SelectionChanged">
                                <ComboBoxItem Content="Structured"/>
                                <ComboBoxItem Content="Flat"/>
                                <ComboBoxItem Content="Timeline"/>
                            </ComboBox>
                        </StackPanel>
                    </DockPanel>
                    <TabControl Grid.Row="2" Background="#131820" BorderBrush="{StaticResource BorderBrushSubtle}">
                        <TabItem Header="Measurement View">
                            <DataGrid Style="{StaticResource AnalyzerDataGridStyle}" AutoGenerateColumns="False" ItemsSource="{Binding Points}" FontSize="12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Timestamp" Binding="{Binding TimestampText}" Width="110"/>
                                    <DataGridTextColumn Header="Point" Binding="{Binding PointAddress}" Width="90"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding PointType}" Width="120"/>
                                    <DataGridTextColumn Header="G/V" Binding="{Binding GroupVariation}" Width="80"/>
                                    <DataGridTextColumn Header="Value" Binding="{Binding ValueText}" Width="100"/>
                                    <DataGridTextColumn Header="Quality" Binding="{Binding Quality}" Width="110"/>
                                    <DataGridTextColumn Header="Class" Binding="{Binding EventClass}" Width="80"/>
                                    <DataGridTextColumn Header="Context" Binding="{Binding Context}" Width="160"/>
                                    <DataGridTextColumn Header="Freshness" Binding="{Binding Freshness}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Event Log">
                            <DataGrid Style="{StaticResource AnalyzerDataGridStyle}" AutoGenerateColumns="False" ItemsSource="{Binding Events}" FontSize="12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding TimestampText}" Width="100"/>
                                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="85"/>
                                    <DataGridTextColumn Header="Event" Binding="{Binding EventType}" Width="140"/>
                                    <DataGridTextColumn Header="Point" Binding="{Binding PointAddress}" Width="90"/>
                                    <DataGridTextColumn Header="Verdict" Binding="{Binding Verdict}" Width="75"/>
                                    <DataGridTextColumn Header="Class" Binding="{Binding EventClass}" Width="80"/>
                                    <DataGridTextColumn Header="Context" Binding="{Binding Context}" Width="140"/>
                                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Findings">
                            <DataGrid Style="{StaticResource AnalyzerDataGridStyle}" AutoGenerateColumns="False" ItemsSource="{Binding Findings}" FontSize="12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Time" Binding="{Binding TimestampText}" Width="90"/>
                                    <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="75"/>
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="200"/>
                                    <DataGridTextColumn Header="Recommendation" Binding="{Binding Recommendation}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Protocol Context">
                            <DataGrid Style="{StaticResource AnalyzerDataGridStyle}" AutoGenerateColumns="False" ItemsSource="{Binding ProtocolContext}" FontSize="12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Parameter" Binding="{Binding Parameter}" Width="160"/>
                                    <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
                                    <DataGridTextColumn Header="Updated" Binding="{Binding Updated}" Width="140"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem Header="Glossary / Legend">
                            <DataGrid Style="{StaticResource AnalyzerDataGridStyle}" AutoGenerateColumns="False" ItemsSource="{Binding GlossaryItems}" FontSize="12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Group" Binding="{Binding Parameter}" Width="120"/>
                                    <DataGridTextColumn Header="Code" Binding="{Binding Value}" Width="180"/>
                                    <DataGridTextColumn Header="Meaning" Binding="{Binding Updated}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <GridSplitter Grid.Row="4" x:Name="StatusGridSplitter" Height="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#2D3545"/>

        <Expander Grid.Row="5" x:Name="StatusHistoryExpander" ExpandDirection="Up" IsExpanded="False" Expanded="StatusHistoryExpander_Expanded" Collapsed="StatusHistoryExpander_Collapsed" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrushSubtle}" BorderThickness="1" Margin="10,0,10,10">
            <Expander.Header>
                <DockPanel LastChildFill="False" Margin="4">
                    <TextBlock Text="Status History" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Border Background="#1E3B60" BorderBrush="#4F7AA8" BorderThickness="1" CornerRadius="9" Padding="8,2" Margin="0,0,6,0">
                        <TextBlock Text="{Binding StatusSummaryText}" Foreground="#BFD9FF" FontSize="11"/>
                    </Border>
                    <TextBlock Text="{Binding ZoomText}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" FontSize="11" Margin="12,0,0,0"/>
                </DockPanel>
            </Expander.Header>
            <Grid Margin="8">
                <DataGrid Style="{StaticResource AnalyzerDataGridStyle}" AutoGenerateColumns="False" ItemsSource="{Binding StatusHistory}" FontSize="11">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Sev" Binding="{Binding Severity}" Width="55"/>
                        <DataGridTextColumn Header="Code" Binding="{Binding Code}" Width="130"/>
                        <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*"/>
                        <DataGridTextColumn Header="Time" Binding="{Binding TimestampText}" Width="155"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Expander>
    </Grid>
</Window>
